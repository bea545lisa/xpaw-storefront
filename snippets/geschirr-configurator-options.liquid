{% comment %}
  Renders the swatch options and hidden line item property inputs for the
  Geschirr configurator. Placed inside the product add-to-cart form.
  Works together with 'geschirr-configurator-preview' (rendered in the
  media column) via assets/geschirr-configurator.js.
{% endcomment %}

<div class="geschirr-configurator__options">
  <fieldset data-property="Gurtband Farbe" data-layer="gurt">
    <legend>Gurtband Farbe: <span class="geschirr-configurator__value" data-value-for="gurt">Hellblau</span></legend>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#FFFFFF" title="Weiß"><input type="radio" name="gurt" value="Weiss" data-color="#FFFFFF"><span class="visually-hidden">Weiß</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#F0EAD6" title="Eierschale"><input type="radio" name="gurt" value="Eierschale" data-color="#F0EAD6"><span class="visually-hidden">Eierschale</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#D8C3A0" title="Beige"><input type="radio" name="gurt" value="Beige" data-color="#D8C3A0"><span class="visually-hidden">Beige</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#D3D3D3" title="Hellgrau"><input type="radio" name="gurt" value="Hellgrau" data-color="#D3D3D3"><span class="visually-hidden">Hellgrau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#A0A0A0" title="Mittelgrau"><input type="radio" name="gurt" value="Mittelgrau" data-color="#A0A0A0"><span class="visually-hidden">Mittelgrau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#555555" title="Dunkelgrau"><input type="radio" name="gurt" value="Dunkelgrau" data-color="#555555"><span class="visually-hidden">Dunkelgrau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#1F1F1F" title="Schwarz"><input type="radio" name="gurt" value="Schwarz" data-color="#1F1F1F"><span class="visually-hidden">Schwarz</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#DA3333" title="Rot"><input type="radio" name="gurt" value="Rot" data-color="#DA3333"><span class="visually-hidden">Rot</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#792525" title="Weinrot"><input type="radio" name="gurt" value="Weinrot" data-color="#792525"><span class="visually-hidden">Weinrot</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#F07E6B" title="Koralle"><input type="radio" name="gurt" value="Koralle" data-color="#F07E6B"><span class="visually-hidden">Koralle</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#F99646" title="Orange"><input type="radio" name="gurt" value="Orange" data-color="#F99646"><span class="visually-hidden">Orange</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#F06EB0" title="Pink"><input type="radio" name="gurt" value="Pink" data-color="#F06EB0"><span class="visually-hidden">Pink</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#FDCBF7" title="Rosa"><input type="radio" name="gurt" value="Rosa" data-color="#FDCBF7"><span class="visually-hidden">Rosa</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#ACBFEF" title="Hellblau"><input type="radio" name="gurt" value="Hellblau" data-color="#ACBFEF" checked><span class="visually-hidden">Hellblau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#74E6F0" title="Türkis"><input type="radio" name="gurt" value="Türkis" data-color="#74E6F0"><span class="visually-hidden">Türkis</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#45567B" title="Navy"><input type="radio" name="gurt" value="Navy" data-color="#45567B"><span class="visually-hidden">Dunkelblau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#9B9B4F" title="Oliv"><input type="radio" name="gurt" value="Oliv" data-color="#9B9B4F"><span class="visually-hidden">Oliv</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#D1E051" title="Lime"><input type="radio" name="gurt" value="Lime" data-color="#D1E051"><span class="visually-hidden">Lime</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#9B7BC7" title="Purple"><input type="radio" name="gurt" value="Purple" data-color="#9B7BC7"><span class="visually-hidden">Purple</span></label>
  </fieldset>

  <fieldset data-property="Polsterung Muster" data-layer="polsterung">
    <legend>Polsterung Muster: <span class="geschirr-configurator__value" data-value-for="polsterung">Camo Grau</span></legend>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#D3D3D3" title="Hellgrau"><input type="radio" name="polsterung" value="Hellgrau" data-color="#D3D3D3"><span class="visually-hidden">Hellgrau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#A0A0A0" title="Mittelgrau"><input type="radio" name="polsterung" value="Mittelgrau" data-color="#A0A0A0"><span class="visually-hidden">Mittelgrau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#D8C3A0" title="Beige"><input type="radio" name="polsterung" value="Beige" data-color="#D8C3A0"><span class="visually-hidden">Beige</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#2E3136" title="Anthrazit"><input type="radio" name="polsterung" value="Anthrazit" data-color="#2E3136"><span class="visually-hidden">Anthrazit</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--pattern" style="--swatch-image:url('{{ "muster-blumen-rose.jpg" | asset_url }}')" title="Blumen Rose"><input type="radio" name="polsterung" value="Blumen Rose" data-pattern="{{ 'muster-blumen-rose.jpg' | asset_url }}" data-pattern-scale="0.5"><span class="visually-hidden">Blumen Rose</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--pattern" style="--swatch-image:url('{{ "muster-camo-grau.jpg" | asset_url }}')" title="Camo Grau"><input type="radio" name="polsterung" value="Camo Grau" data-pattern="{{ 'muster-camo-grau.jpg' | asset_url }}" data-pattern-scale="0.5" checked><span class="visually-hidden">Camo Grau</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--pattern" style="--swatch-image:url('{{ "muster-camo-rose.jpg" | asset_url }}')" title="Camo Rose"><input type="radio" name="polsterung" value="Camo Rose" data-pattern="{{ 'muster-camo-rose.jpg' | asset_url }}" data-pattern-scale="0.5"><span class="visually-hidden">Camo Rose</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--pattern" style="--swatch-image:url('{{ "muster-leo-braun.jpg" | asset_url }}')" title="Leo Braun"><input type="radio" name="polsterung" value="Leo Braun" data-pattern="{{ 'muster-leo-braun.jpg' | asset_url }}"><span class="visually-hidden">Leo Braun</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--pattern" style="--swatch-image:url('{{ "muster-pfoten-aqua.jpg" | asset_url }}')" title="Pfoten Aqua"><input type="radio" name="polsterung" value="Pfoten Aqua" data-pattern="{{ 'muster-pfoten-aqua.jpg' | asset_url }}"><span class="visually-hidden">Pfoten Aqua</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--pattern" style="--swatch-image:url('{{ "muster-pfoten-pink.jpg" | asset_url }}')" title="Pfoten Pink"><input type="radio" name="polsterung" value="Pfoten Pink" data-pattern="{{ 'muster-pfoten-pink.jpg' | asset_url }}"><span class="visually-hidden">Pfoten Pink</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--pattern" style="--swatch-image:url('{{ "muster-leo-blau.jpg" | asset_url }}')" title="Leo Blau"><input type="radio" name="polsterung" value="Leo Blau" data-pattern="{{ 'muster-leo-blau.jpg' | asset_url }}"><span class="visually-hidden">Leo Blau</span></label>
  </fieldset>

  <fieldset data-property="Schnallen Farbe" data-layer="schnallen">
    <legend>Schnallen Farbe: <span class="geschirr-configurator__value" data-value-for="schnallen">Schwarz</span></legend>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#FFFFFF" title="Weiß"><input type="radio" name="schnallen" value="Weiss" data-color="#FFFFFF"><span class="visually-hidden">Weiß</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#3D3D3D" title="Schwarz"><input type="radio" name="schnallen" value="Schwarz" data-color="#3D3D3D" checked><span class="visually-hidden">Schwarz</span></label>
  </fieldset>

  <fieldset data-property="Metallteile Farbe" data-layer="metal">
    <legend>Metallteile Farbe: <span class="geschirr-configurator__value" data-value-for="metal">Schwarz</span></legend>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--metallic" style="--swatch-color:#1F1F1F" title="Schwarz"><input type="radio" name="metal" value="Schwarz" data-color="#1F1F1F" checked><span class="visually-hidden">Schwarz</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--metallic" style="--swatch-color:#C6A66A" title="Gold"><input type="radio" name="metal" value="Gold" data-color="#C6A66A"><span class="visually-hidden">Gold</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--metallic" style="--swatch-color:#C0C0C0" title="Silber"><input type="radio" name="metal" value="Silber" data-color="#C0C0C0"><span class="visually-hidden">Silber</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--metallic" style="--swatch-color:#3A3B3D" title="Gunmetal"><input type="radio" name="metal" value="Gunmetal" data-color="#3A3B3D"><span class="visually-hidden">Gunmetal</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--metallic" style="--swatch-color:#D98C7A" title="Rosegold"><input type="radio" name="metal" value="Rosegold" data-color="#D98C7A"><span class="visually-hidden">Rosegold</span></label>
  </fieldset>
</div>

{%- comment -%} Hidden inputs -> go into {% form 'product' %} as properties[...] {%- endcomment -%}
<input type="hidden" name="properties[Gurtband Farbe]" value="Hellblau" data-hidden-for="gurt">
<input type="hidden" name="properties[Polsterung Muster]" value="Camo Grau" data-hidden-for="polsterung">
<input type="hidden" name="properties[Schnallen Farbe]" value="Schwarz" data-hidden-for="schnallen">
<input type="hidden" name="properties[Metallteile Farbe]" value="Schwarz" data-hidden-for="metal">
