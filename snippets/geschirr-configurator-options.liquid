{% comment %}
  Renders the swatch options and hidden line item property inputs for the
  Geschirr configurator. Placed inside the product add-to-cart form.
  Works together with 'geschirr-configurator-preview' (rendered in the
  media column) via assets/geschirr-configurator.js.
{% endcomment %}

<div class="geschirr-configurator__options">
  <fieldset data-property="Gurtband Farbe" data-layer="gurt">
    <legend>Gurtband Farbe: <span class="geschirr-configurator__value" data-value-for="gurt">Weiß</span></legend>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#FFFFFF" title="Weiß"><input type="radio" name="gurt" value="Weiss" data-color="#FFFFFF" checked><span class="visually-hidden">Weiß</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#F0EAD6" title="Eierschale"><input type="radio" name="gurt" value="Eierschale" data-color="#F0EAD6"><span class="visually-hidden">Eierschale</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#D8C3A0" title="Beige"><input type="radio" name="gurt" value="Beige" data-color="#D8C3A0"><span class="visually-hidden">Beige</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#D3D3D3" title="Hellgrau"><input type="radio" name="gurt" value="Hellgrau" data-color="#D3D3D3"><span class="visually-hidden">Hellgrau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#A0A0A0" title="Mittelgrau"><input type="radio" name="gurt" value="Mittelgrau" data-color="#A0A0A0"><span class="visually-hidden">Mittelgrau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#555555" title="Dunkelgrau"><input type="radio" name="gurt" value="Dunkelgrau" data-color="#555555"><span class="visually-hidden">Dunkelgrau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#1F1F1F" title="Schwarz"><input type="radio" name="gurt" value="Schwarz" data-color="#1F1F1F"><span class="visually-hidden">Schwarz</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#FF6F61" title="Koralle"><input type="radio" name="gurt" value="Koralle" data-color="#FF6F61"><span class="visually-hidden">Koralle</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#FF7A00" title="Orange"><input type="radio" name="gurt" value="Orange" data-color="#FF7A00"><span class="visually-hidden">Orange</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#E91E8C" title="Pink"><input type="radio" name="gurt" value="Pink" data-color="#E91E8C"><span class="visually-hidden">Pink</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#7EC8E3" title="Hellblau"><input type="radio" name="gurt" value="Hellblau" data-color="#7EC8E3"><span class="visually-hidden">Hellblau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#1A3D7C" title="Dunkelblau"><input type="radio" name="gurt" value="Dunkelblau" data-color="#1A3D7C"><span class="visually-hidden">Dunkelblau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#6B6B2A" title="Oliv"><input type="radio" name="gurt" value="Oliv" data-color="#6B6B2A"><span class="visually-hidden">Oliv</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#A4C639" title="Lime"><input type="radio" name="gurt" value="Lime" data-color="#A4C639"><span class="visually-hidden">Lime</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#6A3FA0" title="Purple"><input type="radio" name="gurt" value="Purple" data-color="#6A3FA0"><span class="visually-hidden">Purple</span></label>
  </fieldset>

  <fieldset data-property="Polsterung Muster" data-layer="polsterung">
    <legend>Polsterung Muster: <span class="geschirr-configurator__value" data-value-for="polsterung">Hellgrau</span></legend>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#D3D3D3" title="Hellgrau"><input type="radio" name="polsterung" value="Hellgrau" data-color="#D3D3D3" checked><span class="visually-hidden">Hellgrau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#A0A0A0" title="Mittelgrau"><input type="radio" name="polsterung" value="Mittelgrau" data-color="#A0A0A0"><span class="visually-hidden">Mittelgrau</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#D8C3A0" title="Beige"><input type="radio" name="polsterung" value="Beige" data-color="#D8C3A0"><span class="visually-hidden">Beige</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#1F1F1F" title="Schwarz"><input type="radio" name="polsterung" value="Schwarz" data-color="#1F1F1F"><span class="visually-hidden">Schwarz</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--pattern" style="--swatch-image:url('{{ "pattern-streifen.png" | asset_url }}')" title="Streifen"><input type="radio" name="polsterung" value="Streifen" data-pattern="{{ 'pattern-streifen.png' | asset_url }}"><span class="visually-hidden">Streifen</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--pattern" style="--swatch-image:url('{{ "pattern-punkte.png" | asset_url }}')" title="Punkte"><input type="radio" name="polsterung" value="Punkte" data-pattern="{{ 'pattern-punkte.png' | asset_url }}"><span class="visually-hidden">Punkte</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--pattern" style="--swatch-image:url('{{ "pattern-karo.png" | asset_url }}')" title="Karo"><input type="radio" name="polsterung" value="Karo" data-pattern="{{ 'pattern-karo.png' | asset_url }}"><span class="visually-hidden">Karo</span></label>
  </fieldset>

  <fieldset data-property="Schnallen Farbe" data-layer="schnallen">
    <legend>Schnallen Farbe: <span class="geschirr-configurator__value" data-value-for="schnallen">Weiß</span></legend>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#FFFFFF" title="Weiß"><input type="radio" name="schnallen" value="Weiss" data-color="#FFFFFF" checked><span class="visually-hidden">Weiß</span></label>
    <label class="geschirr-configurator__swatch" style="--swatch-color:#1F1F1F" title="Schwarz"><input type="radio" name="schnallen" value="Schwarz" data-color="#1F1F1F"><span class="visually-hidden">Schwarz</span></label>
  </fieldset>

  <fieldset data-property="Metallteile Farbe" data-layer="metal">
    <legend>Metallteile Farbe: <span class="geschirr-configurator__value" data-value-for="metal">Schwarz</span></legend>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--metallic" style="--swatch-color:#1F1F1F" title="Schwarz"><input type="radio" name="metal" value="Schwarz" data-color="#1F1F1F" checked><span class="visually-hidden">Schwarz</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--metallic" style="--swatch-color:#C6A66A" title="Gold"><input type="radio" name="metal" value="Gold" data-color="#C6A66A"><span class="visually-hidden">Gold</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--metallic" style="--swatch-color:#C0C0C0" title="Silber"><input type="radio" name="metal" value="Silber" data-color="#C0C0C0"><span class="visually-hidden">Silber</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--metallic" style="--swatch-color:#75858C" title="Gunmetal"><input type="radio" name="metal" value="Gunmetal" data-color="#75858C"><span class="visually-hidden">Gunmetal</span></label>
    <label class="geschirr-configurator__swatch geschirr-configurator__swatch--metallic" style="--swatch-color:#DCC7BE" title="Rosegold"><input type="radio" name="metal" value="Rosegold" data-color="#DCC7BE"><span class="visually-hidden">Rosegold</span></label>
  </fieldset>
</div>

{%- comment -%} Hidden inputs -> go into {% form 'product' %} as properties[...] {%- endcomment -%}
<input type="hidden" name="properties[Gurtband Farbe]" value="Weiß" data-hidden-for="gurt">
<input type="hidden" name="properties[Polsterung Muster]" value="Hellgrau" data-hidden-for="polsterung">
<input type="hidden" name="properties[Schnallen Farbe]" value="Weiß" data-hidden-for="schnallen">
<input type="hidden" name="properties[Metallteile Farbe]" value="Schwarz" data-hidden-for="metal">
