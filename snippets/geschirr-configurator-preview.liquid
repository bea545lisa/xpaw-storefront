{% comment %}
  Renders the layered canvas preview for the Geschirr configurator.
  Placed in the media column of the product page.
  Works together with 'geschirr-configurator-options' (rendered in buy-buttons)
  via assets/geschirr-configurator.js, which queries the whole document.
{% endcomment %}

<div class="geschirr-configurator__preview-wrapper">
  <div class="geschirr-configurator__preview">
    <span class="product__media-icon" aria-hidden="true">
      <span class="svg-wrapper">
        {{- 'icon-zoom.svg' | inline_asset_content -}}
      </span>
    </span>
    <canvas class="geschirr-configurator__outline" width="1000" height="1000"></canvas>
    <canvas class="geschirr-configurator__layer" data-layer="polsterung" width="1000" height="1000"></canvas>
    <canvas class="geschirr-configurator__layer" data-layer="gurt" width="1000" height="1000"></canvas>
    <canvas class="geschirr-configurator__layer" data-layer="schnallen" width="1000" height="1000"></canvas>
    <canvas class="geschirr-configurator__layer" data-layer="metal" width="1000" height="1000"></canvas>
    <canvas class="geschirr-configurator__layer" data-layer="label" width="1000" height="1000"></canvas>
    <canvas class="geschirr-configurator__shading" width="1000" height="1000"></canvas>
  </div>
</div>

<div class="geschirr-configurator__export-row">
  <button type="button" class="geschirr-configurator__export-button" data-mode="studio">Vorschaubild herunterladen</button>
  <button type="button" class="geschirr-configurator__export-button" data-mode="transparent">Transparent (für Promo)</button>
</div>

<img class="geschirr-configurator__mask-source" data-mask="polsterung" src="{{ 'geschirr-mask-polsterung.png' | asset_url }}" hidden alt="">
<img class="geschirr-configurator__mask-source" data-mask="gurt" src="{{ 'geschirr-mask-gurt.png' | asset_url }}" hidden alt="">
<img class="geschirr-configurator__mask-source" data-mask="schnallen" src="{{ 'geschirr-mask-schnallen.png' | asset_url }}" hidden alt="">
<img class="geschirr-configurator__mask-source" data-mask="metal" src="{{ 'geschirr-mask-metall.png' | asset_url }}" hidden alt="">
<img class="geschirr-configurator__mask-source" data-mask="label" src="{{ 'geschirr-mask-label.png' | asset_url }}" hidden alt="">
<img class="geschirr-configurator__shading-source" src="{{ 'geschirr-shading.png' | asset_url }}" hidden alt="">
<img class="geschirr-configurator__label-source" src="{{ 'geschirr-label.png' | asset_url }}" hidden alt="">

{{ 'geschirr-configurator.css' | asset_url | stylesheet_tag }}
{{ 'geschirr-configurator.js' | asset_url | script_tag }}
