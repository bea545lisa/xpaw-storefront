{% comment %}
  Renders the harness (Geschirr) configurator with a layered canvas preview.
  Accepts:
  - product: {Object} product object
  Usage:
  {% render 'geschirr-configurator', product: product %}
{% endcomment %}

<geschirr-configurator class="geschirr-configurator">
  <div class="geschirr-configurator__preview">
    <canvas class="geschirr-configurator__layer" data-layer="polsterung" width="1000" height="1000"></canvas>
    <canvas class="geschirr-configurator__layer" data-layer="gurt" width="1000" height="1000"></canvas>
    <canvas class="geschirr-configurator__layer" data-layer="schnallen" width="1000" height="1000"></canvas>
    <canvas class="geschirr-configurator__layer" data-layer="metal" width="1000" height="1000"></canvas>
    <img class="geschirr-configurator__shading" src="{{ 'geschirr-shading.png' | asset_url }}" alt="">
  </div>

  <div class="geschirr-configurator__options">
    <fieldset data-property="Gurtband Farbe" data-layer="gurt">
      <legend>Gurtband Farbe</legend>
      <label><input type="radio" name="gurt" value="Grün" data-color="#4CAF50" checked> Grün</label>
      <label><input type="radio" name="gurt" value="Blau" data-color="#2E6FDB"> Blau</label>
      <label><input type="radio" name="gurt" value="Schwarz" data-color="#1f1f1f"> Schwarz</label>
    </fieldset>

    <fieldset data-property="Polsterung Farbe" data-layer="polsterung">
      <legend>Polsterung Farbe</legend>
      <label><input type="radio" name="polsterung" value="Rot" data-color="#D8342C" checked> Rot</label>
      <label><input type="radio" name="polsterung" value="Beige" data-color="#D8C3A0"> Beige</label>
      <label><input type="radio" name="polsterung" value="Schwarz" data-color="#1f1f1f"> Schwarz</label>
    </fieldset>

    <fieldset data-property="Schnallen Farbe" data-layer="schnallen">
      <legend>Schnallen Farbe</legend>
      <label><input type="radio" name="schnallen" value="Schwarz" data-color="#1f1f1f" checked> Schwarz</label>
      <label><input type="radio" name="schnallen" value="Grau" data-color="#8a8a8a"> Grau</label>
    </fieldset>

    <fieldset data-property="Metallteile Farbe" data-layer="metal">
      <legend>Metallteile Farbe</legend>
      <label><input type="radio" name="metal" value="Silber" data-color="#c0c0c0" checked> Silber</label>
      <label><input type="radio" name="metal" value="Gold" data-color="#d4af37"> Gold</label>
    </fieldset>
  </div>

  {%- comment -%} Hidden inputs -> go into {% form 'product' %} as properties[...] {%- endcomment -%}
  <input type="hidden" name="properties[Gurtband Farbe]" value="Grün" data-hidden-for="gurt">
  <input type="hidden" name="properties[Polsterung Farbe]" value="Rot" data-hidden-for="polsterung">
  <input type="hidden" name="properties[Schnallen Farbe]" value="Schwarz" data-hidden-for="schnallen">
  <input type="hidden" name="properties[Metallteile Farbe]" value="Silber" data-hidden-for="metal">

  <img class="geschirr-configurator__mask-source" data-mask="polsterung" src="{{ 'geschirr-mask-polsterung.png' | asset_url }}" hidden alt="">
  <img class="geschirr-configurator__mask-source" data-mask="gurt" src="{{ 'geschirr-mask-gurt.png' | asset_url }}" hidden alt="">
  <img class="geschirr-configurator__mask-source" data-mask="schnallen" src="{{ 'geschirr-mask-schnallen.png' | asset_url }}" hidden alt="">
  <img class="geschirr-configurator__mask-source" data-mask="metal" src="{{ 'geschirr-mask-metall.png' | asset_url }}" hidden alt="">
</geschirr-configurator>

{{ 'geschirr-configurator.css' | asset_url | stylesheet_tag }}
{{ 'geschirr-configurator.js' | asset_url | script_tag }}
