{% comment %}
  Renders the harness (Geschirr) configurator with a layered canvas preview.
  Accepts:
  - product: {Object} product object
  Usage:
  {% render 'geschirr-configurator', product: product %}
{% endcomment %}

<geschirr-configurator class="geschirr-configurator">
  <div class="geschirr-configurator__preview">
    <canvas class="geschirr-configurator__layer" data-layer="polsterung" width="1000" height="1000"></canvas>
    <canvas class="geschirr-configurator__layer" data-layer="gurt" width="1000" height="1000"></canvas>
    <canvas class="geschirr-configurator__layer" data-layer="schnallen" width="1000" height="1000"></canvas>
    <canvas class="geschirr-configurator__layer" data-layer="metal" width="1000" height="1000"></canvas>
    <img class="geschirr-configurator__shading" src="{{ 'geschirr-shading.png' | asset_url }}" alt="">
  </div>

  <div class="geschirr-configurator__options">
    <fieldset data-property="Gurtband Farbe" data-layer="gurt">
      <legend>Gurtband Farbe: <span class="geschirr-configurator__value" data-value-for="gurt">Weiß</span></legend>
      <label class="swatch" style="--swatch-color:#FFFFFF" title="Weiß"><input type="radio" name="gurt" value="Weiss" data-color="#FFFFFF" checked><span class="visually-hidden">Weiß</span></label>
      <label class="swatch" style="--swatch-color:#F0EAD6" title="Eierschale"><input type="radio" name="gurt" value="Eierschale" data-color="#F0EAD6"><span class="visually-hidden">Eierschale</span></label>
      <label class="swatch" style="--swatch-color:#D8C3A0" title="Beige"><input type="radio" name="gurt" value="Beige" data-color="#D8C3A0"><span class="visually-hidden">Beige</span></label>
      <label class="swatch" style="--swatch-color:#D3D3D3" title="Hellgrau"><input type="radio" name="gurt" value="Hellgrau" data-color="#D3D3D3"><span class="visually-hidden">Hellgrau</span></label>
      <label class="swatch" style="--swatch-color:#A0A0A0" title="Mittelgrau"><input type="radio" name="gurt" value="Mittelgrau" data-color="#A0A0A0"><span class="visually-hidden">Mittelgrau</span></label>
      <label class="swatch" style="--swatch-color:#555555" title="Dunkelgrau"><input type="radio" name="gurt" value="Dunkelgrau" data-color="#555555"><span class="visually-hidden">Dunkelgrau</span></label>
      <label class="swatch" style="--swatch-color:#1F1F1F" title="Schwarz"><input type="radio" name="gurt" value="Schwarz" data-color="#1F1F1F"><span class="visually-hidden">Schwarz</span></label>
      <label class="swatch" style="--swatch-color:#FF6F61" title="Koralle"><input type="radio" name="gurt" value="Koralle" data-color="#FF6F61"><span class="visually-hidden">Koralle</span></label>
      <label class="swatch" style="--swatch-color:#FF7A00" title="Orange"><input type="radio" name="gurt" value="Orange" data-color="#FF7A00"><span class="visually-hidden">Orange</span></label>
      <label class="swatch" style="--swatch-color:#E91E8C" title="Pink"><input type="radio" name="gurt" value="Pink" data-color="#E91E8C"><span class="visually-hidden">Pink</span></label>
      <label class="swatch" style="--swatch-color:#7EC8E3" title="Hellblau"><input type="radio" name="gurt" value="Hellblau" data-color="#7EC8E3"><span class="visually-hidden">Hellblau</span></label>
      <label class="swatch" style="--swatch-color:#1A3D7C" title="Dunkelblau"><input type="radio" name="gurt" value="Dunkelblau" data-color="#1A3D7C"><span class="visually-hidden">Dunkelblau</span></label>
      <label class="swatch" style="--swatch-color:#6B6B2A" title="Oliv"><input type="radio" name="gurt" value="Oliv" data-color="#6B6B2A"><span class="visually-hidden">Oliv</span></label>
      <label class="swatch" style="--swatch-color:#A4C639" title="Lime"><input type="radio" name="gurt" value="Lime" data-color="#A4C639"><span class="visually-hidden">Lime</span></label>
      <label class="swatch" style="--swatch-color:#6A3FA0" title="Purple"><input type="radio" name="gurt" value="Purple" data-color="#6A3FA0"><span class="visually-hidden">Purple</span></label>
    </fieldset>

    <fieldset data-property="Polsterung Muster" data-layer="polsterung">
      <legend>Polsterung Muster: <span class="geschirr-configurator__value" data-value-for="polsterung">Hellgrau</span></legend>
      <label class="swatch" style="--swatch-color:#D3D3D3" title="Hellgrau"><input type="radio" name="polsterung" value="Hellgrau" data-color="#D3D3D3" checked><span class="visually-hidden">Hellgrau</span></label>
      <label class="swatch" style="--swatch-color:#A0A0A0" title="Mittelgrau"><input type="radio" name="polsterung" value="Mittelgrau" data-color="#A0A0A0"><span class="visually-hidden">Mittelgrau</span></label>
      <label class="swatch" style="--swatch-color:#D8C3A0" title="Beige"><input type="radio" name="polsterung" value="Beige" data-color="#D8C3A0"><span class="visually-hidden">Beige</span></label>
      <label class="swatch" style="--swatch-color:#1F1F1F" title="Schwarz"><input type="radio" name="polsterung" value="Schwarz" data-color="#1F1F1F"><span class="visually-hidden">Schwarz</span></label>
      <label class="swatch swatch--pattern" style="--swatch-image:url('{{ "pattern-streifen.png" | asset_url }}')" title="Streifen"><input type="radio" name="polsterung" value="Streifen" data-pattern="{{ 'pattern-streifen.png' | asset_url }}"><span class="visually-hidden">Streifen</span></label>
      <label class="swatch swatch--pattern" style="--swatch-image:url('{{ "pattern-punkte.png" | asset_url }}')" title="Punkte"><input type="radio" name="polsterung" value="Punkte" data-pattern="{{ 'pattern-punkte.png' | asset_url }}"><span class="visually-hidden">Punkte</span></label>
      <label class="swatch swatch--pattern" style="--swatch-image:url('{{ "pattern-karo.png" | asset_url }}')" title="Karo"><input type="radio" name="polsterung" value="Karo" data-pattern="{{ 'pattern-karo.png' | asset_url }}"><span class="visually-hidden">Karo</span></label>
    </fieldset>

    <fieldset data-property="Schnallen Farbe" data-layer="schnallen">
      <legend>Schnallen Farbe: <span class="geschirr-configurator__value" data-value-for="schnallen">Schwarz</span></legend>
      <label class="swatch" style="--swatch-color:#1F1F1F" title="Schwarz"><input type="radio" name="schnallen" value="Schwarz" data-color="#1F1F1F" checked><span class="visually-hidden">Schwarz</span></label>
      <label class="swatch" style="--swatch-color:#8A8A8A" title="Grau"><input type="radio" name="schnallen" value="Grau" data-color="#8A8A8A"><span class="visually-hidden">Grau</span></label>
    </fieldset>

    <fieldset data-property="Metallteile Farbe" data-layer="metal">
      <legend>Metallteile Farbe: <span class="geschirr-configurator__value" data-value-for="metal">Schwarz</span></legend>
      <label class="swatch" style="--swatch-color:#1F1F1F" title="Schwarz"><input type="radio" name="metal" value="Schwarz" data-color="#1F1F1F" checked><span class="visually-hidden">Schwarz</span></label>
      <label class="swatch" style="--swatch-color:#D4AF37" title="Gold"><input type="radio" name="metal" value="Gold" data-color="#D4AF37"><span class="visually-hidden">Gold</span></label>
      <label class="swatch" style="--swatch-color:#C0C0C0" title="Silber"><input type="radio" name="metal" value="Silber" data-color="#C0C0C0"><span class="visually-hidden">Silber</span></label>
      <label class="swatch" style="--swatch-color:#2A3439" title="Gunmetal"><input type="radio" name="metal" value="Gunmetal" data-color="#2A3439"><span class="visually-hidden">Gunmetal</span></label>
      <label class="swatch" style="--swatch-color:#B76E79" title="Rosegold"><input type="radio" name="metal" value="Rosegold" data-color="#B76E79"><span class="visually-hidden">Rosegold</span></label>
    </fieldset>
  </div>

  {%- comment -%} Hidden inputs -> go into {% form 'product' %} as properties[...] {%- endcomment -%}
  <input type="hidden" name="properties[Gurtband Farbe]" value="Weiß" data-hidden-for="gurt">
  <input type="hidden" name="properties[Polsterung Muster]" value="Hellgrau" data-hidden-for="polsterung">
  <input type="hidden" name="properties[Schnallen Farbe]" value="Schwarz" data-hidden-for="schnallen">
  <input type="hidden" name="properties[Metallteile Farbe]" value="Schwarz" data-hidden-for="metal">

  <img class="geschirr-configurator__mask-source" data-mask="polsterung" src="{{ 'geschirr-mask-polsterung.png' | asset_url }}" hidden alt="">
  <img class="geschirr-configurator__mask-source" data-mask="gurt" src="{{ 'geschirr-mask-gurt.png' | asset_url }}" hidden alt="">
  <img class="geschirr-configurator__mask-source" data-mask="schnallen" src="{{ 'geschirr-mask-schnallen.png' | asset_url }}" hidden alt="">
  <img class="geschirr-configurator__mask-source" data-mask="metal" src="{{ 'geschirr-mask-metall.png' | asset_url }}" hidden alt="">
</geschirr-configurator>

{{ 'geschirr-configurator.css' | asset_url | stylesheet_tag }}
{{ 'geschirr-configurator.js' | asset_url | script_tag }}
