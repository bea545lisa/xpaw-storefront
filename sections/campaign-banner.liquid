{%- style -%}
  #CampaignBanner-{{ section.id }} {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: {{ section.settings.text_alignment }};
    min-height: 400px;
    padding: 40px 24px;
    overflow: hidden;
    color: #ffffff;
  }

  #CampaignBanner-{{ section.id }} .campaign-banner__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  #CampaignBanner-{{ section.id }}::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #000000;
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  #CampaignBanner-{{ section.id }} .campaign-banner__content {
    position: relative;
    z-index: 2;
    max-width: 600px;
  }

  #CampaignBanner-{{ section.id }} .campaign-banner__heading {
    font-size: 2.5rem;
    margin: 0 0 12px;
  }

  #CampaignBanner-{{ section.id }} .campaign-banner__text {
    font-size: 1.1rem;
    margin: 0 0 24px;
  }
{%- endstyle -%}

<div id="CampaignBanner-{{ section.id }}" class="campaign-banner color-{{ section.settings.color_scheme }}">
  {%- if section.settings.image != blank -%}
    {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'campaign-banner__image', loading: 'lazy' }}
  {%- endif -%}

  <div class="campaign-banner__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="campaign-banner__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="campaign-banner__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button">
        {{ section.settings.button_label | escape }}
      </a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.campaign_banner.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.campaign_banner.settings.image.label"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "t:sections.campaign_banner.settings.overlay_opacity.label",
      "default": 40
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.campaign_banner.settings.heading.label",
      "default": "t:sections.campaign_banner.settings.heading.default"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.campaign_banner.settings.text.label",
      "default": "t:sections.campaign_banner.settings.text.default"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.campaign_banner.settings.button_label.label",
      "default": "t:sections.campaign_banner.settings.button_label.default"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.campaign_banner.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.campaign_banner.settings.text_alignment.label",
      "options": [
        { "value": "left", "label": "t:sections.campaign_banner.settings.text_alignment.options__1.label" },
        { "value": "center", "label": "t:sections.campaign_banner.settings.text_alignment.options__2.label" },
        { "value": "right", "label": "t:sections.campaign_banner.settings.text_alignment.options__3.label" }
      ],
      "default": "center"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.campaign_banner.settings.color_scheme.label",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "t:sections.campaign_banner.presets.name"
    }
  ]
}
{% endschema %}
