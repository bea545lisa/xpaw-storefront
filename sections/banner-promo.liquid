{% comment %}
  Universal promo banner: cycling images on one side, a hand-drawn arrow
  pointing to a heading/text/button on the other side. Stacks vertically
  on mobile (images, then arrow rotated, then text). Not tied to any
  specific product - reusable for any promo.
{% endcomment %}

<div
  class="banner-promo"
  data-interval="{{ section.settings.interval }}"
  style="
    --banner-promo-heading-size: {{ section.settings.heading_size }}px;
    --banner-promo-heading-color: {{ section.settings.heading_color }};
    --banner-promo-text-color: {{ section.settings.text_color }};
    --banner-promo-background: {{ section.settings.background }};
    {%- if section.settings.background_dark != blank -%}
    --banner-promo-background-dark: {{ section.settings.background_dark }};
    {%- endif -%}
    {%- if section.settings.background_image != blank -%}
    --banner-promo-background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}');
    {%- endif -%}
    {%- if section.settings.background_image_dark != blank -%}
    --banner-promo-background-image-dark: url('{{ section.settings.background_image_dark | image_url: width: 2000 }}');
    {%- endif -%}
    --banner-promo-button-bg: {{ section.settings.button_background }};
    --banner-promo-button-border: {{ section.settings.button_border_color }};
    --banner-promo-button-text: {{ section.settings.button_text_color }};
    --banner-promo-arrow-color: {{ section.settings.arrow_color }};
    --banner-promo-text-size: {{ section.settings.text_size }}px;
    {%- if section.settings.border_enabled -%}
      {%- if section.settings.border_auto -%}
    --banner-promo-border: {{ section.settings.border_width }}px solid rgba(var(--color-foreground), 0.6);
      {%- elsif section.settings.border_color != blank -%}
    --banner-promo-border: {{ section.settings.border_width }}px solid {{ section.settings.border_color }};
      {%- endif -%}
    {%- endif -%}
  "
  {{ section.shopify_attributes }}
>
  <div class="banner-promo__stage">
    {%- for block in section.blocks -%}
      {%- if block.type == 'image' -%}
        <img
          class="banner-promo__slide{% if forloop.first %} banner-promo__slide--active{% endif %}"
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | default: section.settings.heading | escape }}"
          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          data-block-id="{{ block.id }}"
          {{ block.shopify_attributes }}
        >
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.show_arrow -%}
    <div class="banner-promo__arrow" aria-hidden="true">
      {%- if section.settings.arrow_image != blank -%}
        <img class="banner-promo__arrow-image" src="{{ section.settings.arrow_image | image_url: width: 400 }}" alt="">
      {%- else -%}
        <svg viewBox="0 0 500 181" class="banner-promo__arrow-svg">
