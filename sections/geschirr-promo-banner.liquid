{% comment %}
  Custom promo banner: cycling product images on one side, a hand-drawn
  arrow pointing to a heading/text/button on the other side. Stacks
  vertically on mobile (images, then arrow rotated, then text).
{% endcomment %}

<div class="geschirr-promo" data-interval="{{ section.settings.interval }}" {{ section.shopify_attributes }}>
  <div class="geschirr-promo__stage">
    {%- for block in section.blocks -%}
      {%- if block.type == 'image' -%}
        <img
          class="geschirr-promo__slide{% if forloop.first %} geschirr-promo__slide--active{% endif %}"
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | default: section.settings.heading | escape }}"
          loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
          {{ block.shopify_attributes }}
        >
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="geschirr-promo__arrow" aria-hidden="true">
    <svg viewBox="0 0 160 90" class="geschirr-promo__arrow-svg">
      <path d="M6 10 C 50 4, 90 55, 120 40 C 130 35, 128 30, 122 28" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M138 52 L 122 28 L 108 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </div>

  <div class="geschirr-promo__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="geschirr-promo__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="geschirr-promo__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a href="{{ section.settings.button_link }}" class="geschirr-promo__button">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</div>

{{ 'geschirr-promo-banner.css' | asset_url | stylesheet_tag }}
{{ 'geschirr-promo-banner.js' | asset_url | script_tag }}

{% schema %}
{
  "name": "Geschirr Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Gestalte dein eigenes Geschirr"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button-Text",
      "default": "Jetzt gestalten"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button-Link"
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Wechsel-Intervall (Sekunden)",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "default": 2.5
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Bild",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Geschirr-Bild (transparent)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Geschirr Promo Banner",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
